# Copy to .env.local for local development. Set the same keys in Render for the hosted app.
# Never commit real values. See docs/PAYPAL_SETUP.md for where each value comes from.

# --- App ---
NODE_ENV=development
# Public base URL (used in 402 challenges, MCP URLs and webhook setup). Locally: your tunnel URL.
APP_BASE_URL=http://localhost:3000
# Random 32+ byte strings: `openssl rand -base64 32`
SESSION_SECRET=change-me
RECEIPT_SIGNING_SECRET=change-me
# Shows the persona switcher and the "simulated" traffic generator.
DEMO_MODE=true

# --- Database (Neon) ---
# Direct connection: migrations and schema changes.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Pooled connection (host ends in -pooler): the running app.
DATABASE_URL_POOLED="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Separate Postgres that `npm test` wipes and re-migrates on every run. Never the app database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/piko_test

# Sam's agent Key for `npm run agent`. `npm run seed` prints it.
PIKO_AGENT_KEY=

# --- PayPal (sandbox) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook you register on the sandbox app; needed to verify webhook signatures.
PAYPAL_WEBHOOK_ID=
# Browser-safe client id for the JS SDK (same value as PAYPAL_CLIENT_ID).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Sandbox business account that sells the monitor at the end of the demo (used as the Orders payee).
PAYPAL_DEMO_SHOP_EMAIL=

# --- AI ---
GEMINI_API_KEY=
# Pinned model ids, not -latest aliases (see docs/decisions/0011). lib/llm tries the fallbacks in order on 503/429.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
# Optional fallback provider.
GROQ_API_KEY=

# --- Sponsor APIs ---
CHANNEL3_API_KEY=

# --- Business rules ---
# Platform fee in basis points (500 = 5%).
PLATFORM_FEE_BPS=500
# Automatic seller payout threshold in micro-USD (1000000 = $1.00).
PAYOUT_THRESHOLD_MICRO=1000000
# Circuit breaker: freeze an agent after this many calls inside the window.
BREAKER_MAX_CALLS=50
BREAKER_WINDOW_SECONDS=10
# Challenge and receipt lifetime.
CHALLENGE_TTL_SECONDS=30
RECEIPT_TTL_SECONDS=60
# Upstream timeout for the gateway before refunding the call.
UPSTREAM_TIMEOUT_MS=10000
